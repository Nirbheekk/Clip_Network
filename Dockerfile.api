FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/clip-engine/package.json packages/clip-engine/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile

FROM deps AS builder
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm --filter @clip-network/shared build \
 && pnpm --filter @clip-network/clip-engine build \
 && pnpm --filter @clip-network/api exec prisma generate \
 && pnpm --filter @clip-network/api build

FROM node:22-alpine AS runner
RUN apk add --no-cache ffmpeg && addgroup -S app && adduser -S app -G app
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4100
COPY --from=builder /app ./
RUN mkdir -p /app/apps/api/data && chown -R app:app /app
USER app
EXPOSE 4100
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:4100/api/health || exit 1
CMD ["node", "apps/api/dist/index.js"]
