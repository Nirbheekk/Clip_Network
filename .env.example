# =============================================================================
# Clip Network Commercial SaaS — Environment Configuration
# =============================================================================
NODE_ENV=development
PORT=4100
PUBLIC_APP_URL="http://localhost:3100"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4100"

# Database (SQLite for local dev; PostgreSQL URL for staging/production)
DATABASE_URL="file:./data/clip-network.db"

# Security & Encryption (generate 32+ random bytes in production)
ENCRYPTION_MASTER_KEY="replace-with-strong-32-byte-secret-in-production"
BILLING_WEBHOOK_SECRET="replace-with-strong-hmac-sha256-webhook-secret"
SUPER_ADMIN_EMAIL="admin@clipnetwork.io"

# Stripe Live Billing (optional — falls back to honest SANDBOX_WEBHOOK when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# Transactional Email via Resend (optional — falls back to token-redacted SANDBOX_LOG)
RESEND_API_KEY=""
EMAIL_FROM="Clip Network <noreply@clipnetwork.io>"

# Social Publishing via Postiz (optional — falls back to SANDBOX_SIMULATED)
POSTIZ_API_KEY=""
POSTIZ_API_BASE_URL="https://api.postiz.com/public/v1"

# S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO — falls back to LOCAL_SANDBOX)
S3_ENDPOINT=""
S3_BUCKET="clip-network-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Background Channel Monitor Interval (ms, 0 to disable)
CHANNEL_MONITOR_INTERVAL_MS="300000"
